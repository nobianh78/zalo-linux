{
  "name": "zalo-linux",
  "version": "26.10.21",
  "description": "Zalo PC cho Linux (không chính thức, không liên kết với VNG)",
  "homepage": "https://github.com/nobianh78/zalo-linux",
  "author": {
    "name": "nobianh78",
    "email": "nobianh78@users.noreply.github.com"
  },
  "main": "runtime/launcher.js",
  "scripts": {
    "start": "./start_zalo.sh",
    "dev": "./start_zalo.sh --dev",
    "pack": "electron-builder --dir",
    "dist": "node tools/zalo/vendor-7zz.js && electron-builder --linux AppImage deb rpm",
    "dist:appimage": "node tools/zalo/vendor-7zz.js && electron-builder --linux AppImage",
    "dist:deb": "node tools/zalo/vendor-7zz.js && electron-builder --linux deb",
    "build:tadaza": "node zalo_source/linux_compat/tadaza/build.js",
    "dist:rpm": "node tools/zalo/vendor-7zz.js && electron-builder --linux rpm",
    "zalo:prepare": "node tools/zalo/prepare.js"
  },
  "build": {
    "appId": "io.github.nobianh78.zalolinux",
    "productName": "Zalo Linux",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "runtime/**/*",
      "zalo-patches/**/*",
      "assets/icons/**/*",
      "zalo_source/bootstrap.js",
      "zalo_source/linux_compat/**/*",
      "zalo_source/native/nativelibs/sqlite3/binding/napi-v6-linux-x64/**/*"
    ],
    "asar": false,
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "maintainer": "nobianh78 <nobianh78@users.noreply.github.com>",
      "category": "Network",
      "icon": "assets/icons",
      "artifactName": "Zalo-Linux-${version}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Zalo Linux",
          "GenericName": "Nhắn tin",
          "Comment": "Zalo không chính thức cho Linux",
          "StartupWMClass": "Zalo"
        }
      }
    },
    "deb": {
      "artifactName": "zalo-linux_${version}_amd64.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "python3",
        "alsa-utils"
      ],
      "recommends": [
        "pulseaudio-utils",
        "libappindicator3-1"
      ]
    },
    "rpm": {
      "artifactName": "zalo-linux-${version}.x86_64.${ext}",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret",
        "python3",
        "alsa-utils"
      ],
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none"
      ]
    },
    "extraResources": [
      {
        "from": "build/vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "22.3.9",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "sharp": "^0.35.5"
  }
}
